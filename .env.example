# ===== LLM 配置（可选，不填则自动使用 heuristic/mock 模式，Demo 完全可跑）=====
# LLM_PROVIDER: mock | dashscope | openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=qwen3.8max
# 仅 openai 兼容模式需要（dashscope 使用百炼兼容地址，自动填充）
LLM_BASE_URL=

# OpenAI-compatible Agent endpoint (example: https://api.openai-next.com/v1)
# Keep secrets in the deployment environment, never commit them.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai-next.com/v1
# LLM_API_KEY=your-token
# LLM_MODEL=gpt-4o-mini

# ===== 数据获取 =====
# 公开数据源：Amazon Reviews 2023 (McAuley Lab, HuggingFace 公开镜像)
# 优先级：本地缓存 data/raw/* -> HF镜像流式下载 -> synthetic demo 数据
HF_ENDPOINT=https://hf-mirror.com
MAX_PUBLIC_ROWS=15000

# ===== 算法 =====
# 1=尝试 sentence-transformers embedding 聚类（需自行安装，CPU 较慢），0=TF-IDF+KMeans
ENABLE_EMBEDDINGS=0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===== 服务 =====
BACKEND_PORT=8000
FRONTEND_PORT=5173
